# 离线 Mock 与单元测试无需任何配置。
# 接入真实模型时：复制为 .env 并填写（.env 已被 .gitignore 忽略，不要提交真实密钥）。

# 模型来源：mock / openai / anthropic（命令行 --provider 优先）
LLM_PROVIDER=mock

# ---- OpenAI 兼容接口（默认 DeepSeek）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TEMPERATURE=0
# DeepSeek 当前可用模型：deepseek-v4-pro（默认）、deepseek-flash（更快更便宜；deepseek-chat 为其别名）
# 通义千问：OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1，OPENAI_MODEL=qwen-plus

# ---- Claude（Anthropic 官方 SDK）----
ANTHROPIC_API_KEY=
# 走代理/中转时填写；SDK 也会直接读取系统里已有的 ANTHROPIC_BASE_URL
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# 拒答时由服务端自动换模型重试（beta 功能）；代理不支持时改为 off
ANTHROPIC_FALLBACKS=default
